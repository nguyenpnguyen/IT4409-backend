        {
          "name": "T01 GET /users không token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error.code = UNAUTHENTICATED\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "T02 GET /users bằng member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"error.code = FORBIDDEN\", () => pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_member}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "T03 GET /users phân trang + sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const { data, meta } = pm.response.json();",
                  "pm.test(\"meta đúng\", () => {",
                  "    pm.expect(meta.page).to.eql(2);",
                  "    pm.expect(meta.limit).to.eql(3);",
                  "    pm.expect(meta.totalPages).to.eql(Math.max(1, Math.ceil(meta.totalItems / 3)));",
                  "    pm.expect(data.length).to.be.at.most(3);",
                  "});",
                  "pm.test(\"Sắp xếp theo fullName\", () => {",
                  "    const names = data.map((u) => u.fullName);",
                  "    pm.expect(names).to.eql([...names].sort((a, b) => a.localeCompare(b)));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_auditor}}"
              }
            ],
            "url": "{{baseUrl}}/users?page=2&limit=3&sort=fullName"
          }
        },
        {
          "name": "T04 GET /users tìm kiếm + lọc",
          "event": [
