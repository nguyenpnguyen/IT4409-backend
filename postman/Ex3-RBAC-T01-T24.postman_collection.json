        {
          "name": "Lấy id user-manager (GET /me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"manager_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_manager}}"
              }
            ],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Lấy id các vai trò (GET /roles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const byCode = {};",
                  "pm.response.json().data.forEach((r) => (byCode[r.code] = r.id));",
                  "[\"super-admin\", \"user-manager\", \"auditor\", \"member\", \"helpdesk\"].forEach((c) => {",
                  "    pm.test(`Có role ${c}`, () => pm.expect(byCode[c]).to.be.a(\"string\"));",
                  "    pm.collectionVariables.set(`role_${c.replace(\"-\", \"_\")}`, byCode[c]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/roles?limit=100"
          }
        }
      ]
    },
