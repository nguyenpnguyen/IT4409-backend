                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test(\"Có header Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(u.id));",
                  "pm.test(\"Không có passwordHash\", () => pm.expect(u).to.not.have.property(\"passwordHash\"));",
                  "pm.collectionVariables.set(\"test_user_id\", u.id);"
                ]
              }
