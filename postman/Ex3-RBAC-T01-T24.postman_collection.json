              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Chỉ bản ghi khớp\", () => {",
                  "    pm.response.json().data.forEach((u) => {",
                  "        pm.expect(u.status).to.eql(\"active\");",
                  "        pm.expect((u.fullName + \" \" + u.email).toLowerCase()).to.include(\"nguyen\");",
                  "    });",
                  "});"
